#!/usr/bin/env bash
# Mirrors GitLab CI ruby::rspec before_script. Runs inside ruby:3.2.2.
set -euo pipefail
cd "$(dirname "$0")/.."

git config --global --add safe.directory "$(pwd)" || true

: "${NODE_MAJOR:=18}"

# Appraisal gemfiles are relative; keep absolute across chdir into the dummy app.
if [[ -n "${BUNDLE_GEMFILE:-}" && "${BUNDLE_GEMFILE}" != /* ]]; then
  export BUNDLE_GEMFILE="$(pwd)/${BUNDLE_GEMFILE}"
fi

apt-get update -qq && apt-get install -y ca-certificates curl gnupg libpq-dev

mkdir -p /etc/apt/keyrings
curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg
echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_${NODE_MAJOR}.x nodistro main" | tee /etc/apt/sources.list.d/nodesource.list
apt-get update && apt-get install -y -qq nodejs
npm install -g yarn --force

gem install bundler
bundle config set path "$(pwd)/vendor"
RAILS_ENV=development bundle install -j "$(nproc)"
rm -rf coverage
bundle exec rake test_app
