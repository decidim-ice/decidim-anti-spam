# frozen_string_literal: true

# Hand-maintained appraisal gemfile for Decidim 0.29 + decidim-apartment.
# Prefer editing Appraisals then carefully regenerating.

source "https://rubygems.org"

gem "bootsnap", "~> 1.4"
gem "concurrent-ruby", "= 1.3.4"
gem "decidim", "~> 0.29.2"
gem "decidim-apartment",
    git: "https://gitlab.com/lappis-unb/decidimbr/infra/participa-gem",
    branch: "feat/imports"
gem "decidim-spam_signal", path: ".."
gem "decidim-toggle",
    git: "https://git.octree.ch/decidim/vocacity/decidim-modules/decidim-toggle",
    branch: "main"
gem "deface", ">= 1.8.1"
gem "puma", ">= 6.3.1"
gem "ros-apartment", "3.4.4", require: "apartment"
gem "uglifier", "~> 4.1"
gem "uri", "1.1.1"

group :development, :test do
  gem "appraisal", "~> 2.5", require: false
  gem "better_html"
  gem "brakeman", "~> 6.1"
  gem "byebug", "~> 11.0", platform: :mri
  gem "decidim-dev", "~> 0.29.2"
  gem "erb_lint"
  gem "parallel_tests", "~> 4.2"
end

group :development do
  gem "letter_opener_web", "~> 2.0"
  gem "listen", "~> 3.1"
  gem "web-console", "~> 4.2"
end

group :test do
  gem "capybara", "~> 3.24"
  gem "rspec-rails", "~> 6.0"
  gem "rubocop-faker"
end
